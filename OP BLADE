-- ===== CONFIG =====
local HP_PERCENT = 0.6 -- 60%
local TRIGGERED = false

-- ===== LOOP =====
task.spawn(function()
	while _G.AutoLeaveOnHP do
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		if hum and hum.Health > 0 then
			local percent = hum.Health / hum.MaxHealth

			if percent <= HP_PERCENT and not TRIGGERED then
				TRIGGERED = true
				Remote:FireServer()
			end

			-- ถ้าเลือดเด้งกลับ รีเซ็ต
			if percent > HP_PERCENT then
				TRIGGERED = false
			end
		end

		task.wait(0.1)
	end
end)
	end,
})
