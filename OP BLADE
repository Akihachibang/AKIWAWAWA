_G.AutoEnterArena = not _G.AutoEnterArena

if not _G.AutoEnterArena then
	warn("❌ Auto Enter Arena : OFF")
	return
end

warn("✅ Auto Enter Arena : ON")

-- ===== SERVICES =====
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- ===== REMOTES =====
local Net = ReplicatedStorage
	:WaitForChild("Packages")
	:WaitForChild("_Index")
	:WaitForChild("sleitnick_net@0.2.0")
	:WaitForChild("net")

local EnterRemote = Net:WaitForChild("RE/Arena_PlayerEnter")
local TeleportRemote = Net:WaitForChild("RE/Arena_TeleportToArena")

-- ===== CONFIG =====
local TRIGGERED = false -- กันยิงซ้ำ

-- ===== FUNCTION เช็คว่าอยู่ใน Lobby ไหม =====
local function IsStandingInLobby()
	local char = LocalPlayer.Character
	if not char then return false end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	-- Raycast ลงพื้น
	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {char}
	rayParams.FilterType = Enum.RaycastFilterType.Blacklist

	local result = workspace:Raycast(
		hrp.Position,
		Vector3.new(0, -6, 0),
		rayParams
	)

	if result and result.Instance then
		return result.Instance:IsDescendantOf(workspace:WaitForChild("Lobby"))
	end

	return false
end

-- ===== LOOP =====
task.spawn(function()
	while _G.AutoEnterArena do
		if IsStandingInLobby() and not TRIGGERED then
			TRIGGERED = true

			-- 🔥 เล่นสองสคริปต์พร้อมกัน
			EnterRemote:FireServer()
			TeleportRemote:FireServer()
		end

		-- ออกนอก Lobby แล้วค่อยรีเซ็ต
		if not IsStandingInLobby() then
			TRIGGERED = false
		end

		task.wait(0.2)
	end
end)
	end,
})
