	Callback = function(tr)
		-- ==============================
-- WARP TO PLAYER MAP (ADD ONLY)
-- ==============================
local Players = game:GetService("Players")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local HRP = Character:WaitForChild("HumanoidRootPart")

local mapName = "PlayerMap_" .. Player.UserId
local playerMap = workspace:WaitForChild(mapName)
local enemyPart = playerMap
	:WaitForChild("EnemySpawnBoxs")
	:WaitForChild("Part")

-- วาปไปจุด EnemySpawnBoxs.Part
HRP.CFrame = enemyPart.CFrame + Vector3.new(0, 3, 0)

-- =================================================
-- ===== AUTO LOOT SCRIPT (YOUR ORIGINAL SCRIPT) ====
-- ===== ❌ NOT MODIFIED ============================
-- =================================================

-- ===== TOGGLE =====
_G.AutoLoot = not _G.AutoLoot
if not _G.AutoLoot then
	warn("❌ Auto Loot : OFF")
	return
end
warn("✅ Auto Loot : ON")

-- ===== SERVICES =====
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local HRP = Character:WaitForChild("HumanoidRootPart")

local LootAnchor = workspace:WaitForChild("LootAnchor")

-- ===== SETTINGS =====
local MOVE_TIME = 0.2
local LOCK_Y_OFFSET = -7.6 -- ระดับที่ต้องการ (จากตำแหน่งเริ่ม)

-- ล็อกระดับความสูงตั้งต้น
local LOCK_Y = HRP.Position.Y + LOCK_Y_OFFSET

-- ===== LOOP =====
task.spawn(function()
	while _G.AutoLoot do

		local loots = {}
		for _, v in pairs(LootAnchor:GetChildren()) do
			if v:IsA("Attachment") and v.Name:match("^LootAttachment_") then
				table.insert(loots, v)
			end
		end

		if #loots > 0 then
			local loot = loots[math.random(#loots)]

			if loot and loot.Parent then
				local pos = loot.WorldPosition

				-- ❗ คุมเฉพาะ X Z / Y ถูกล็อก
				local targetCFrame = CFrame.new(
					pos.X,
					LOCK_Y,
					pos.Z
				)

				local tween = TweenService:Create(
					HRP,
					TweenInfo.new(MOVE_TIME, Enum.EasingStyle.Linear),
					{CFrame = targetCFrame}
				)

				tween:Play()
				tween.Completed:Wait()
			end
		end

		task.wait(0.2)
	end
end)
	end,
})
