-- ตัวแปร Global เพื่อคุมการเปิด/ปิด
getgenv().AutoMoney = false

--// 4. แก้ไขชื่อปุ่ม และ Logic การทำงาน
MoneySection:NewToggle({
    Title = "Dupe Money", -- แก้คำผิดจาก Mpney
    Default = false,
    Callback = function(state)
        getgenv().AutoMoney = state
        
        if state then
            task.spawn(function()
                -- ดึง Remote ตรงนี้แทน เพื่อป้องกัน error ถ้าสคริปต์รันก่อนเกมโหลดเสร็จ
                local MagnetRemote = ReplicatedStorage:WaitForChild("Tutorial_MagnetActivated", 5)
                local PickupRemote = ReplicatedStorage:WaitForChild("RequestLootPickup", 5)

                if not MagnetRemote or not PickupRemote then
                    warn("หา Remote ไม่เจอ กรุณารอเกมโหลดสักครู่")
                    return
                end

                while getgenv().AutoMoney do
                    pcall(function()
                        MagnetRemote:FireServer()
                    end)

                    local spamDuration = 0.1
                    local loopStart = tick()
                    
                    -- Loop เก็บของ
                    while (tick() - loopStart < spamDuration) and getgenv().AutoMoney do
                        for _, block in ipairs(workspace:GetChildren()) do
                            if not getgenv().AutoMoney then break end
                            
                            if block.Name == "OakLogDROP" then
                                -- ใช้ task.spawn เพื่อไม่ให้รอ Server ตอบกลับจนเกมค้าง
                                task.spawn(function()
                                    pcall(function()
                                        PickupRemote:InvokeServer(block)
                                    end)
                                end)
                            end
                        end
                        task.wait() 
                    end
                    task.wait()
                end
            end)
        end
    end,
})

--// 5. แยก Shop Section ออกมาชัดเจน
local ShopSection = TabFrame:NewSection({
    Title = "Shop",
    Icon = "rbxassetid://86013236874625",
    Position = "Left"
})

ShopSection:NewDropdown({
    Title = "Buy Platform",
    Data = {
        "Oak Platform",       -- 50
        "Birch Platform",     -- 50
        "Cherry Platform",    -- 50
        "Bloodwood Platform", -- 50
        "Acacia Platform",    -- 50
        "Grass Platform",     -- 75
        "Stone Platform",     -- 100
        "Granite Platform",   -- 100
        "Diorite Platform",   -- 100
        "Blackstone Platform" -- 100
    },
    Default = "Oak Platform",
    Callback = function(selectedItem)
        local amount = 50 

        if selectedItem == "Grass Platform" then
            amount = 75
        elseif selectedItem == "Stone Platform" 
            or selectedItem == "Granite Platform" 
            or selectedItem == "Diorite Platform" 
            or selectedItem == "Blackstone Platform" then
            amount = 100
        end

        local args = {
            selectedItem,
            amount
        }
        
        local purchaseTool = ReplicatedStorage:WaitForChild("PurchaseTool", 2)
        if purchaseTool then
            purchaseTool:FireServer(unpack(args))
            print("Purchased: " .. selectedItem .. " | Amount: " .. amount)
        else
            warn("ไม่เจอ Remote PurchaseTool")
        end
    end,
})

