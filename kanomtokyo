local player = game.Players.LocalPlayer
local players = game:GetService("Players")
local runService = game:GetService("RunService")
local safeZones = workspace:WaitForChild("SafeZones"):GetChildren()

--  ฟังก์ชันรีเฟรชตัวละครเมื่อเราตาย
local function getHRP()
	local char = player.Character or player.CharacterAdded:Wait()
	return char:WaitForChild("HumanoidRootPart")
end

-- ตรวจสอบว่าผู้เล่นอยู่ใกล้ SafeZone หรือไม่
local function isNearSafeZone(targetPos)
	for _, zone in pairs(safeZones) do
		if (zone.Position - targetPos).Magnitude < 100 then -- รัศมี 50 studs
			return true
		end
	end
	return false
end

--  ค้นหาผู้เล่นที่มีชีวิตและไม่อยู่ใน SafeZone
local function getAlivePlayers()
	local alive = {}
	for _, plr in pairs(players:GetPlayers()) do
		if plr ~= player and plr.Character and plr.Character:FindFirstChild("Humanoid") then
			local hum = plr.Character.Humanoid
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			if hum.Health > 0 and hrp and not isNearSafeZone(hrp.Position) then
				table.insert(alive, plr)
			end
		end
	end
	return alive
end

-- ฟังก์ชันตามผู้เล่น
local function followPlayer(target)
	local hrp = getHRP()
	local targetChar = target.Character
	if not targetChar then return end
	local targetHum = targetChar:FindFirstChild("Humanoid")
	local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
	if not targetHum or not targetHRP then return end

	print("กำลังตาม:", target.Name)
	
	-- วาร์ปไปหา
	hrp.CFrame = targetHRP.CFrame + Vector3.new(0, 0, -5)

	local startTime = tick()

	-- ลอยตามจนกว่าผู้เล่นจะตายหรือครบ 10 วิ
	while getgenv().AutoFollowEnabled and targetHum.Health > 0 do
		task.wait(0.1)
		if (tick() - startTime) >= 10 then
			print(" เปลี่ยนเป้าหมายใหม่ (หมดเวลา)")
			break
		end
		if not isNearSafeZone(targetHRP.Position) then
			hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 5, 4)
		end
	end
	print(" จบการติดตาม:", target.Name)
end

