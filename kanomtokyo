--==================================================
task.spawn(function()
    while task.wait(0.25) do
        if not _G.AutoFarm then continue end

        local questName, enemyName = GetQuestData()
        if not questName then continue end

        if not HasQuest() then
            AcceptQuest(questName)
            continue
        end

        local enemy = FindEnemy(enemyName)
        if enemy then
            repeat
                if not _G.AutoFarm then break end
                task.wait(_G.AttackDelay)
                TPAbove(enemy.HumanoidRootPart)
                NormalAttack()
            until enemy.Humanoid.Health <= 0 or not enemy.Parent
        end
    end
end)

