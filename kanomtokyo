local function FindEnemy(name)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name == name
        and v:FindFirstChild("Humanoid")
        and v.Humanoid.Health > 0
        and v:FindFirstChild("HumanoidRootPart") then
            return v
        end
    end
end

