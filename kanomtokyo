    local ctrlHeld = false
    local debounce = false
    local ABLE_RANGE = 400 -- ระยะสูงสุดที่อนุญาตให้วาป (เปลี่ยนหรือตั้งเป็น math.huge เพื่อไม่จำกัด)
    
