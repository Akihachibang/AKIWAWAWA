local function stopAll()
	if FollowConnection then
		FollowConnection:Disconnect()
		FollowConnection = nil
	end
	if AttackConnection then
		AttackConnection:Disconnect()
		AttackConnection = nil
	end
end

--==================================================
-- START ATTACK LOOP
--==================================================
local function startAttack()
	if AttackConnection then
		AttackConnection:Disconnect()
	end

	AttackConnection = RunService.Heartbeat:Connect(function()
		if not AutoFarmEnabled then return end
		pcall(function()
			attackRemote:FireServer(unpack(attackArgs))
		end)
	end)
end

--==================================================
-- START FOLLOW (อยู่ใต้บอสเท่านั้น)
--==================================================
local function startFollow()
	stopAll()
	if not AutoFarmEnabled then return end

	local SMOOTHING = 0.25
	local boss = nil
	local bossRoot = nil

	FollowConnection = RunService.Heartbeat:Connect(function()
		if not AutoFarmEnabled then return end

		local hrp = getCharRoot()
		if not hrp then return end

		-- หา boss แบบ realtime
		if not boss or not boss.Parent then
			boss = findBoss()
			if not boss then return end
			bossRoot = getRoot(boss)
			if not bossRoot then return end
		end

		-- ใต้บอสตรง ๆ
		local targetPos =
			bossRoot.Position
			- Vector3.new(0, DistanceBelowBoss, 0)

		local cf = CFrame.new(targetPos, bossRoot.Position)
		hrp.CFrame = hrp.CFrame:Lerp(cf, SMOOTHING)
	end)

	startAttack()
end

