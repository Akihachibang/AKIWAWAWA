local mapNames = {}; if workspace:FindFirstChild("Maps") then for _, m in pairs(workspace.Maps:GetChildren()) do if m:IsA("Model") and m.Name ~= "SeaHitbox" then table.insert(mapNames, m.Name) end end end; table.sort(mapNames)
LocationSection:NewDropdown({ Title = "Select Map", Data = mapNames, Default = "Select Map", Callback = function(v) local tm = workspace.Maps:FindFirstChild(v); if tm and tm.PrimaryPart then LocalPlayer.Character.HumanoidRootPart.CFrame = tm.PrimaryPart.CFrame * CFrame.new(0,10,0) end end })

local swordNpcNames = {}; local swordFolder = workspace.Main:FindFirstChild("NPCs") and workspace.Main.NPCs:FindFirstChild("Sword"); if swordFolder then for _, n in pairs(swordFolder:GetChildren()) do if n:IsA("Model") then table.insert(swordNpcNames, n.Name) end end end; table.sort(swordNpcNames)
NPCSection:NewDropdown({ Title = "Select Sword NPC", Data = swordNpcNames, Default = "Select NPC", Callback = function(v) if swordFolder then local t = swordFolder:FindFirstChild(v); if t and t:FindFirstChild("HumanoidRootPart") then LocalPlayer.Character.HumanoidRootPart.CFrame = t.HumanoidRootPart.CFrame * CFrame.new(0,5,0) end end end })

-- ==============================
-- 6. Main Logic Loop (Consolidated)
-- ==============================
task.spawn(function()
    while task.wait(0.5) do
        local DidAction = false
        
        -- Auto Boss
        if _G.AutoBoss and not DidAction then
            pcall(function()
                local bossPath = BossData[_G.SelectedBoss]
                local bossModel = GetFolderFromPath(bossPath)
                if bossModel and bossModel:FindFirstChild("Humanoid") and bossModel.Humanoid.Health > 0 then
                    DidAction = true
                    TweenTo(GetFarmPosition(bossModel.HumanoidRootPart))
                    LockPosition(bossModel, "Boss")
                    AttackLoop(bossModel, "Boss")
                end
            end)
        end

        -- Auto Dungeon
        if _G.AutoDungeon and not DidAction then
            pcall(function()
                if workspace.Main:FindFirstChild("Characters") and workspace.Main.Characters:FindFirstChild("Dungeon") then
                    local dPath = workspace.Main.Characters.Dungeon
                    local target = nil
                    if dPath:FindFirstChild("Boss") then target = GetRandomMob(dPath.Boss) end
                    if not target and dPath:FindFirstChild("Mob") then target = GetRandomMob(dPath.Mob) end
                    if target then
                        DidAction = true
                        TweenTo(GetFarmPosition(target.HumanoidRootPart))
                        LockPosition(target, "Dungeon")
                        AttackLoop(target, "Dungeon")
                    end
                end
            end)
        end

        -- Auto Farm Monster
        if _G.AutoFarmMonster and not DidAction then
            pcall(function()
                local mobName = _G.SelectedMonster
                local pathData = MonsterLocations[mobName]
                local mobFolder
                
                if mobName == "Desert Thief" or mobName == "Katana Master" then
                    mobFolder = workspace.Main.Characters["Sandora Island"]
                elseif pathData then
                    mobFolder = GetFolderFromPath(pathData)
                end
                
                if not mobFolder and workspace.Main.Characters:FindFirstChild("Sandora Island") then mobFolder = workspace.Main.Characters["Sandora Island"] end

                if mobFolder then
                    local target = GetClosestMob(mobFolder, mobName)
                    if target then
                        DidAction = true
                        TweenTo(GetFarmPosition(target.HumanoidRootPart))
                        LockPosition(target, "FarmMonster")
                        AttackLoop(target, "FarmMonster")
                    end
                end
            end)
        end

        -- Auto Farm Level (Legacy)
        if _G.AutoFarm and not DidAction then
            pcall(function()
                local level = LocalPlayer.Info.Level.Value
                local questData = {
                    {l=0,q="1",f={"Main","Characters","Windmill Village","Bandit"},n="Bandit"},
                    {l=100,q="2",f={"Main","Characters","Windmill Village","Bandit Leader"},n="Bandit Leader"},
                    {l=200,q="3",f={"Main","Characters","Whispering Jungle","Skeleton"},n="Skeleton"},
                    {l=300,q="4",f={"Main","Characters","Whispering Jungle","Pirate Skeleton"},n="Pirate Skeleton"},
                    {l=450,q="5",f={"Main","Characters","Sandora Island","Desert Thief"},n="Desert Thief"},
                    {l=600,q="6",f={"Main","Characters","Sandora Island","Katana Master"},n="Katana Master"},
                    {l=750,q="7",f={"Main","Characters","Glacier Isle","Mihawk"},n="Mihawk"},
                    {l=1000,q="8",f={"Main","Characters","Forge Isle","Slayer's Trainee"},n="Slayer's Trainee"},
                    {l=1500,q="9",f={"Main","Characters","Jujutsu Highschool","Sorcerer's Student"},n="Sorcerer's Student"},
                    {l=2000,q="10",f={"Main","Characters","Jujutsu Highschool","Sorcerer's Teacher"},n="Sorcerer's Teacher"},
                    {l=3500,q="11",f={"Main","Characters","Konoha Village","Konoha's Ninja"},n="Konoha's Ninja"},
                    {l=4500,q="12",f={"Main","Characters","Konoha Village","Konoha's Head Ninja"},n="Konoha's Head Ninja"}
                }
                local current = questData[1]
                for _,v in ipairs(questData) do if level >= v.l then current = v end end
                local npc = workspace.Main.NPCs.Quests[current.q].HumanoidRootPart
                
                if not HasQuest() then
                    if (RootPart.Position - npc.Position).Magnitude > 3 then TweenTo(npc.CFrame) end
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game); task.wait(1.5); VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    task.wait(1)
                else
                    local mobFolder = GetFolderFromPath(current.f)
                    if current.n == "Katana Master" or current.n == "Desert Thief" then mobFolder = workspace.Main.Characters["Sandora Island"] end
                    local target = GetClosestMob(mobFolder, current.n)
                    if target then
                        DidAction = true
                        TweenTo(GetFarmPosition(target.HumanoidRootPart))
                        LockPosition(target, "Farm")
                        AttackLoop(target, "Farm")
                    end
                end
            end)
        end
    end
end)
