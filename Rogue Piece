task.spawn(function()
    while task.wait(0.5) do
        local DidAction = false
        
        -- Priority Boss
        if _G.Settings.AutoBoss and not DidAction then
            pcall(function()
                local bossPath = BossData[_G.Settings.SelectedBoss]
                local bossModel = GetFolderFromPath(bossPath)
                if IsValidTarget(bossModel) then
                    UpdateStatus("Attacking Boss: " .. _G.Settings.SelectedBoss)
                    DidAction = true
                    TweenTo(GetFarmPosition(bossModel.HumanoidRootPart))
                    LockPosition(bossModel, "Boss")
                    AttackLoop(bossModel, "Boss")
                end
            end)
        end

        if not DidAction and _G.Settings.AutoDungeon then
            pcall(function()
                if workspace.Main:FindFirstChild("Characters") and workspace.Main.Characters:FindFirstChild("Dungeon") then
                    local dPath = workspace.Main.Characters.Dungeon; local target = nil
                    if dPath:FindFirstChild("Boss") then target = GetRandomMob(dPath.Boss) end
                    if not target and dPath:FindFirstChild("Mob") then target = GetRandomMob(dPath.Mob) end
                    if target then
                        UpdateStatus("Dungeon: Attacking Mob")
                        DidAction = true
                        TweenTo(GetFarmPosition(target.HumanoidRootPart))
                        LockPosition(target, "Dungeon")
                        AttackLoop(target, "Dungeon")
                    else
                        UpdateStatus("Dungeon: Searching...")
                    end
                end
            end)
        end

        if not DidAction and _G.Settings.AutoFarmMonster then
            pcall(function()
                local mobName = _G.Settings.SelectedMonster; local pathData = MonsterLocations[mobName]; local mobFolder
                if mobName == "Desert Thief" or mobName == "Katana Master" then mobFolder = workspace.Main.Characters["Sandora Island"]
                elseif pathData then mobFolder = GetFolderFromPath(pathData) end
                if not mobFolder and workspace.Main.Characters:FindFirstChild("Sandora Island") then mobFolder = workspace.Main.Characters["Sandora Island"] end
                if mobFolder then
                    local target = GetClosestMob(mobFolder, mobName)
                    if target then
                        UpdateStatus("Farming: " .. mobName)
                        DidAction = true
                        TweenTo(GetFarmPosition(target.HumanoidRootPart))
                        LockPosition(target, "FarmMonster")
                        AttackLoop(target, "FarmMonster")
                    else
                        UpdateStatus("Farming: Searching " .. mobName)
                    end
                end
            end)
        end

        if not DidAction and _G.Settings.AutoFarm then
            pcall(function()
                local level = LocalPlayer.Info.Level.Value
                local questData = {
                    {l=0,q="1",f={"Main","Characters","Windmill Village","Bandit"},n="Bandit"},
                    {l=100,q="2",f={"Main","Characters","Windmill Village","Bandit Leader"},n="Bandit Leader"},
                    {l=200,q="3",f={"Main","Characters","Whispering Jungle","Skeleton"},n="Skeleton"},
                    {l=300,q="4",f={"Main","Characters","Whispering Jungle","Pirate Skeleton"},n="Pirate Skeleton"},
                    {l=450,q="5",f={"Main","Characters","Sandora Island","Desert Thief"},n="Desert Thief"},
                    {l=600,q="6",f={"Main","Characters","Sandora Island","Katana Master"},n="Katana Master"},
                    {l=750,q="7",f={"Main","Characters","Glacier Isle","Mihawk"},n="Mihawk"},
                    {l=1000,q="8",f={"Main","Characters","Forge Isle","Slayer's Trainee"},n="Slayer's Trainee"},
                    {l=1500,q="9",f={"Main","Characters","Jujutsu Highschool","Sorcerer's Student"},n="Sorcerer's Student"},
                    {l=2000,q="10",f={"Main","Characters","Jujutsu Highschool","Sorcerer's Teacher"},n="Sorcerer's Teacher"},
                    {l=3500,q="11",f={"Main","Characters","Konoha Village","Konoha's Ninja"},n="Konoha's Ninja"},
                    {l=4500,q="12",f={"Main","Characters","Konoha Village","Konoha's Head Ninja"},n="Konoha's Head Ninja"}
                }
                local current = questData[1]; for _,v in ipairs(questData) do if level >= v.l then current = v end end
                if workspace.Main:FindFirstChild("NPCs") and workspace.Main.NPCs:FindFirstChild("Quests") then
                    local npc = workspace.Main.NPCs.Quests[current.q].HumanoidRootPart
                    if not HasQuest() then
                        UpdateStatus("Farm Level: Taking Quest")
                        if (RootPart.Position - npc.Position).Magnitude > 3 then TweenTo(npc.CFrame) end
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game); task.wait(1.5); VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game); task.wait(1)
                    else
                        local mobFolder = GetFolderFromPath(current.f)
                        if current.n == "Katana Master" or current.n == "Desert Thief" then mobFolder = workspace.Main.Characters["Sandora Island"] end
                        local target = GetClosestMob(mobFolder, current.n)
                        if target then
                            UpdateStatus("Farm Level: Attacking " .. current.n)
                            DidAction = true
                            TweenTo(GetFarmPosition(target.HumanoidRootPart))
                            LockPosition(target, "Farm")
                            AttackLoop(target, "Farm")
                        else
                            UpdateStatus("Farm Level: Mob not found")
                        end
                    end
                end
            end)
        end
        
        if not DidAction and not _G.Settings.AutoTanjiro and not _G.Settings.AutoFishing then
            UpdateStatus("Idle")
        end
    end
end)
