                        TweenTo(GetFarmPosition(tanjiro.HumanoidRootPart)); LockPosition(tanjiro, "Tanjiro"); AttackLoop(tanjiro, "Tanjiro")
                        if not IsValidTarget(tanjiro) then _G.TanjiroKillCount = 0; task.wait(3) end
