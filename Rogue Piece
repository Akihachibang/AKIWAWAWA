local function GetMyTools()
    local t = {}
    for _,v in pairs(LocalPlayer.Backpack:GetChildren()) do if v:IsA("Tool") then table.insert(t, v.Name) end end
    if LocalPlayer.Character then for _,v in pairs(LocalPlayer.Character:GetChildren()) do if v:IsA("Tool") then table.insert(t, v.Name) end end end
    if #t == 0 then table.insert(t, "Combat") end
    return t
end

local function GetFolderFromPath(pathTable)
    local obj = workspace
    for _, name in ipairs(pathTable) do
        if obj:FindFirstChild(name) then obj = obj[name] else return nil end
    end
    return obj
end

local function HasQuest()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    return gui and gui:FindFirstChild("HUD") and gui.HUD.Bar.List:FindFirstChild("Quest")
end

local function TweenTo(targetCF)
    if not RootPart then return end
    local dist = (RootPart.Position - targetCF.Position).Magnitude
    if dist < 5 then return end
    
    -- SUPER FAST TWEEN
    if dist > 300 then
        RootPart.CFrame = targetCF
    else
        local tween = TweenService:Create(RootPart, TweenInfo.new(dist/2000, Enum.EasingStyle.Linear), {CFrame = targetCF})
        tween:Play()
        local s = tick()
        repeat task.wait() 
            if not (_G.AutoFarm or _G.AutoBoss or _G.AutoDungeon or _G.AutoFarmMonster or _G.AutoTanjiro) then tween:Cancel(); break end
        until (RootPart.Position - targetCF.Position).Magnitude < 5 or tick() - s > 15
    end
end

local function GetFarmPosition(targetRoot)
    local d, m = _G.Distance, _G.PositionMode
    if m == "Under (Look Up)" then return targetRoot.CFrame * CFrame.new(0, -d, 0) * CFrame.Angles(math.rad(90), 0, 0)
    elseif m == "Above (Look Down)" then return targetRoot.CFrame * CFrame.new(0, d, 0) * CFrame.Angles(math.rad(-90), 0, 0)
    else return targetRoot.CFrame * CFrame.new(0, 0, d) end
end

local function LockPosition(target, mode)
    local con
    con = RunService.Heartbeat:Connect(function()
        if not target or not target:FindFirstChild("HumanoidRootPart") or target.Humanoid.Health <= 0 then con:Disconnect(); return end
        
        if mode == "Farm" and not _G.AutoFarm then con:Disconnect(); return end
        if mode == "Boss" and not _G.AutoBoss then con:Disconnect(); return end
        if mode == "Dungeon" and not _G.AutoDungeon then con:Disconnect(); return end
        if mode == "FarmMonster" and not _G.AutoFarmMonster then con:Disconnect(); return end
        if mode == "Tanjiro" and not _G.AutoTanjiro then con:Disconnect(); return end

        RootPart.CFrame = GetFarmPosition(target.HumanoidRootPart)
        RootPart.Velocity = Vector3.new(0,0,0)
    end)
end

local function PressKey(key)
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    task.wait(0.01)
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

local function AttackLoop(target, mode)
    while target and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 do
        if mode == "Farm" and (not _G.AutoFarm or not HasQuest()) then break end
        if mode == "Boss" and not _G.AutoBoss then break end
        if mode == "Dungeon" and not _G.AutoDungeon then break end
        if mode == "FarmMonster" and not _G.AutoFarmMonster then break end
        if mode == "Tanjiro" and not _G.AutoTanjiro then break end

        local toolName = _G.SelectedWeapon
        local tool = LocalPlayer.Backpack:FindFirstChild(toolName) or Character:FindFirstChild(toolName)
        
        if tool then
            if tool.Parent == LocalPlayer.Backpack then Character.Humanoid:EquipTool(tool) end
            pcall(function()
                local args = { "Server", "Combat", "M1s", toolName, 0 }
                if toolName == "Shadow" then args = {"Server", "Combat", "M1s", "Shadow", 2}
                elseif toolName == "Sukuna" then args = {"Server", "Combat", "M1s", "Sukuna", 1} 
                elseif toolName == "Abyssbreaker" then args = {"Server", "Sword", "M1s", "Abyssbreaker", 3} end
                ReplicatedStorage.Remotes.Serverside:FireServer(unpack(args))
            end)
            if _G.AutoSkillSpam then
                PressKey(Enum.KeyCode.Z); PressKey(Enum.KeyCode.X); PressKey(Enum.KeyCode.C); PressKey(Enum.KeyCode.V)
            end
        end
        task.wait()
    end
end

local function GetClosestMob(folder, mobName)
    local closestMob = nil
    local shortestDistance = math.huge
    if folder and RootPart then
        for _, v in ipairs(folder:GetDescendants()) do
            local isMatch = (mobName == nil) or (v.Name == mobName)
            if v:IsA("Model") and isMatch and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                local dist = (RootPart.Position - v.HumanoidRootPart.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestMob = v
                end
            end
        end
    end
    return closestMob
end

local function GetRandomMob(folder)
    local validMobs = {}
    if folder then
        for _, v in ipairs(folder:GetChildren()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                table.insert(validMobs, v)
            end
        end
    end
    if #validMobs > 0 then return validMobs[math.random(1, #validMobs)] end
    return nil
end

local function FindSlayerTraineeFixed()
