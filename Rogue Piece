-- Material (Tanjiro)
MaterialSection:NewToggle({
    Title = "AutoTanjiro (Farm 50 -> Boss)", Default = false,
    Callback = function(Value)
        _G.AutoTanjiro = Value
        if Value then
            _G.AutoFarm = false; _G.AutoBoss = false; _G.AutoDungeon = false; _G.AutoFarmMonster = false
            _G.TanjiroKillCount = 0
            
            task.spawn(function()
                print(">>> Auto Tanjiro Started")
                while _G.AutoTanjiro do
                    if _G.TanjiroKillCount < 50 then
                        local startPos = CFrame.new(-827, 8, 771)
                        if (RootPart.Position - startPos.Position).Magnitude > 250 then
                            TweenTo(startPos); task.wait(0.5)
                        end

                        local target = FindSlayerTraineeFixed()
                        if target then
                            TweenTo(GetFarmPosition(target.HumanoidRootPart))
                            LockPosition(target, "Tanjiro")
                            AttackLoop(target, "Tanjiro")
                            
                            if target.Humanoid.Health <= 0 then
                                _G.TanjiroKillCount = _G.TanjiroKillCount + 1
                            end
                        else
                            task.wait(1)
                        end
                    else
                        -- [[ Updated Coordinates for Tanjiro Summoning ]]
                        local summonPos = CFrame.new(-965, 8, 674)
                        TweenTo(summonPos)
                        task.wait(0.5)
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                        task.wait(2.5)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                        task.wait(0.5)
                        
                        local tanjiro = nil
                        local retry = 0
                        while not tanjiro and retry < 10 and _G.AutoTanjiro do
                            tanjiro = FindTanjiroBoss()
                            task.wait(1); retry = retry + 1
                        end

                        if tanjiro then
                            TweenTo(GetFarmPosition(tanjiro.HumanoidRootPart))
                            LockPosition(tanjiro, "Tanjiro")
                            AttackLoop(tanjiro, "Tanjiro")
                            if tanjiro.Humanoid.Health <= 0 then
                                _G.TanjiroKillCount = 0 
                                task.wait(3)
                            end
                        else
                            task.wait(2)
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end
    end,
})

