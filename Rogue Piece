end

local function GetFolderFromPath(pathTable)
    local obj = workspace
    for _, name in ipairs(pathTable) do
        if obj and obj:FindFirstChild(name) then obj = obj[name] else return nil end
    end
    return obj
end

local function IsValidTarget(target)
    return target and target.Parent and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 and target:FindFirstChild("HumanoidRootPart")
end

local function HasQuest()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    return gui and gui:FindFirstChild("HUD") and gui.HUD.Bar.List:FindFirstChild("Quest")
end

local function TweenTo(targetCF)
    if not RootPart then return end
    local dist = (RootPart.Position - targetCF.Position).Magnitude
    if dist < 5 then return end
    if dist > 300 then RootPart.CFrame = targetCF else
        local tween = TweenService:Create(RootPart, TweenInfo.new(dist/2000, Enum.EasingStyle.Linear), {CFrame = targetCF})
        tween:Play()
        local s = tick()
        repeat task.wait() 
            if not (_G.Settings.AutoFarm or _G.Settings.AutoBoss or _G.Settings.AutoDungeon or _G.Settings.AutoFarmMonster or _G.Settings.AutoTanjiro or _G.Settings.AutoFishing) then tween:Cancel(); break end
        until (RootPart.Position - targetCF.Position).Magnitude < 5 or tick() - s > 15
    end
end

local function GetFarmPosition(targetRoot)
    local d, m = _G.Settings.Distance, _G.Settings.PositionMode
    if m == "Under (Look Up)" then return targetRoot.CFrame * CFrame.new(0, -d, 0) * CFrame.Angles(math.rad(90), 0, 0)
    elseif m == "Above (Look Down)" then return targetRoot.CFrame * CFrame.new(0, d, 0) * CFrame.Angles(math.rad(-90), 0, 0)
    else return targetRoot.CFrame * CFrame.new(0, 0, d) end
end

local function LockPosition(target, mode)
    local con
    con = RunService.Heartbeat:Connect(function()
        if not IsValidTarget(target) then con:Disconnect(); return end
        if mode == "Farm" and not _G.Settings.AutoFarm then con:Disconnect(); return end
        if mode == "Boss" and not _G.Settings.AutoBoss then con:Disconnect(); return end
        if mode == "Dungeon" and not _G.Settings.AutoDungeon then con:Disconnect(); return end
        if mode == "FarmMonster" and not _G.Settings.AutoFarmMonster then con:Disconnect(); return end
        if mode == "Tanjiro" and not _G.Settings.AutoTanjiro then con:Disconnect(); return end
        RootPart.CFrame = GetFarmPosition(target.HumanoidRootPart)
        RootPart.Velocity = Vector3.new(0,0,0)
    end)
end

