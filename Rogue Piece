-- [[ V23 ATTACK LOOP: HITBOX GLITCH + REMOTE ]] --
local function AttackLoop(target, mode)
    while IsValidTarget(target) do
        -- Check Stop Conditions
        if mode == "Farm" and (not _G.Settings.AutoFarm or not HasQuest()) then break end
        if mode == "Boss" and not _G.Settings.AutoBoss then break end
        if mode == "Dungeon" and not _G.Settings.AutoDungeon then break end
        if mode == "FarmMonster" and not _G.Settings.AutoFarmMonster then break end
        if mode == "Tanjiro" and not _G.Settings.AutoTanjiro then break end

        if mode ~= "Boss" and _G.Settings.AutoBoss then
             local bossPath = BossData[_G.Settings.SelectedBoss]
             local bossModel = GetFolderFromPath(bossPath)
             if IsValidTarget(bossModel) then break end
        end

        local toolName = _G.Settings.SelectedWeapon
        local tool = LocalPlayer.Backpack:FindFirstChild(toolName) or Character:FindFirstChild(toolName)
        
        if tool then
            -- ต้องถืออุปกรณ์จริงเพื่อให้ Handle ทำงาน
            if tool.Parent == LocalPlayer.Backpack then Character.Humanoid:EquipTool(tool) end
            
            -- [[ 1. Standard Remote Attack (Stability) ]]
            pcall(function()
                local args = { "Server", "Combat", "M1s", toolName, 0 }
                if toolName == "Shadow" then args = {"Server", "Combat", "M1s", "Shadow", 2}
                elseif toolName == "Sukuna" then args = {"Server", "Combat", "M1s", "Sukuna", 1} 
                elseif toolName == "Abyssbreaker" then args = {"Server", "Sword", "M1s", "Abyssbreaker", 3} end
                ReplicatedStorage.Remotes.Serverside:FireServer(unpack(args))
            end)

            -- [[ 2. HITBOX GLITCH (FireTouchInterest) ]]
            if tool:FindFirstChild("Handle") and target:FindFirstChild("HumanoidRootPart") then
                pcall(function()
                    -- บังคับให้ Hitbox ชนกันรัวๆ 5 รอบต่อลูป (เพิ่มดาเมจแบบ Glitch)
                    for i = 1, 5 do
                        firetouchinterest(tool.Handle, target.HumanoidRootPart, 0) -- แตะ
                        firetouchinterest(tool.Handle, target.HumanoidRootPart, 1) -- ปล่อย
                    end
                end)
            end

            -- Skill Spam
            if _G.Settings.AutoSkillSpam then
                PressKey(Enum.KeyCode.Z); PressKey(Enum.KeyCode.X); PressKey(Enum.KeyCode.C); PressKey(Enum.KeyCode.V)
            end
        end
        task.wait() -- Wait 1 Frame (Fastest safe loop)
    end
end

local function GetClosestMob(folder, mobName)
    local closestMob, dist = nil, math.huge
    if folder and RootPart then
        for _, v in ipairs(folder:GetDescendants()) do
            local isMatch = (mobName == nil) or (v.Name == mobName)
            if v:IsA("Model") and isMatch and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                local d = (RootPart.Position - v.HumanoidRootPart.Position).Magnitude
                if d < dist then dist = d; closestMob = v end
            end
        end
    end
    return closestMob
end

local function GetRandomMob(folder)
    local validMobs = {}
    if folder then
        for _, v in ipairs(folder:GetChildren()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                table.insert(validMobs, v)
            end
        end
    end
    if #validMobs > 0 then return validMobs[math.random(1, #validMobs)] end
    return nil
end

