-- บริการที่จำเป็น
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

-- ตัวแปรเก็บสถานะและการวาด
local ESP_Enabled = false
local ESP_Lines = {} -- เก็บเส้นที่วาดไว้เพื่อลบออกภายหลัง

-- ฟังก์ชันสำหรับวาดเส้น (Drawing API)
local function CreateLine()
    local line = Drawing.new("Line")
    line.Visible = false
    line.From = Vector2.new(0, 0)
    line.To = Vector2.new(0, 0)
    line.Color = Color3.fromRGB(255, 255, 255) -- สีของโครงกระดูก (ขาว)
    line.Thickness = 1
    line.Transparency = 1
    return line
end

-- ฟังก์ชันลบเส้นทั้งหมด (เมื่อปิด ESP หรือผู้เล่นตาย)
local function ClearESP()
    for _, lines in pairs(ESP_Lines) do
        for _, line in pairs(lines) do
            line:Remove()
        end
    end
    ESP_Lines = {}
end

-- ฟังก์ชันหลักในการอัปเดตตำแหน่งเส้น
local function UpdateESP()
    -- ถ้าปิด ESP ให้ลบเส้นทิ้งแล้วหยุดทำงาน
    if not ESP_Enabled then
        ClearESP()
        return
    end

    -- วนลูปผู้เล่นทุกคน
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local char = player.Character
            
            -- สร้างตารางเก็บเส้นสำหรับผู้เล่นคนนี้ถ้ายังไม่มี
            if not ESP_Lines[player] then
                ESP_Lines[player] = {
                    -- R15 Joints (ตัวอย่างบางส่วน)
                    Head_UpperTorso = CreateLine(),
                    UpperTorso_LowerTorso = CreateLine(),
                    
                    -- แขนซ้าย
                    UpperTorso_LeftUpperArm = CreateLine(),
                    LeftUpperArm_LeftLowerArm = CreateLine(),
                    LeftLowerArm_LeftHand = CreateLine(),
                    
                    -- แขนขวา
                    UpperTorso_RightUpperArm = CreateLine(),
                    RightUpperArm_RightLowerArm = CreateLine(),
                    RightLowerArm_RightHand = CreateLine(),
                    
                    -- ขาซ้าย
                    LowerTorso_LeftUpperLeg = CreateLine(),
                    LeftUpperLeg_LeftLowerLeg = CreateLine(),
                    LeftLowerLeg_LeftFoot = CreateLine(),
                    
                    -- ขาขวา
                    LowerTorso_RightUpperLeg = CreateLine(),
                    RightUpperLeg_RightLowerLeg = CreateLine(),
                    RightLowerLeg_RightFoot = CreateLine(),
                }
            end

            local lines = ESP_Lines[player]
            
            -- ฟังก์ชันย่อยสำหรับวาดเส้นเชื่อมระหว่างจุด 2 จุด
            local function ConnectParts(line, partA_Name, partB_Name)
                local partA = char:FindFirstChild(partA_Name)
                local partB = char:FindFirstChild(partB_Name)
                
                if partA and partB then
                    local vectorA, onScreenA = Camera:WorldToViewportPoint(partA.Position)
                    local vectorB, onScreenB = Camera:WorldToViewportPoint(partB.Position)
                    
                    if onScreenA and onScreenB then
                        line.From = Vector2.new(vectorA.X, vectorA.Y)
                        line.To = Vector2.new(vectorB.X, vectorB.Y)
                        line.Visible = true
                        return
                    end
                end
                line.Visible = false
            end

            -- เชื่อมจุดต่างๆ (รองรับ R15 เป็นหลัก)
            ConnectParts(lines.Head_UpperTorso, "Head", "UpperTorso")
            ConnectParts(lines.UpperTorso_LowerTorso, "UpperTorso", "LowerTorso")
            
            -- แขน
            ConnectParts(lines.UpperTorso_LeftUpperArm, "UpperTorso", "LeftUpperArm")
            ConnectParts(lines.LeftUpperArm_LeftLowerArm, "LeftUpperArm", "LeftLowerArm")
            ConnectParts(lines.LeftLowerArm_LeftHand, "LeftLowerArm", "LeftHand")
            
            ConnectParts(lines.UpperTorso_RightUpperArm, "UpperTorso", "RightUpperArm")
            ConnectParts(lines.RightUpperArm_RightLowerArm, "RightUpperArm", "RightLowerArm")
            ConnectParts(lines.RightLowerArm_RightHand, "RightLowerArm", "RightHand")

            -- ขา
            ConnectParts(lines.LowerTorso_LeftUpperLeg, "LowerTorso", "LeftUpperLeg")
            ConnectParts(lines.LeftUpperLeg_LeftLowerLeg, "LeftUpperLeg", "LeftLowerLeg")
            ConnectParts(lines.LeftLowerLeg_LeftFoot, "LeftLowerLeg", "LeftFoot")

            ConnectParts(lines.LowerTorso_RightUpperLeg, "LowerTorso", "RightUpperLeg")
            ConnectParts(lines.RightUpperLeg_RightLowerLeg, "RightUpperLeg", "RightLowerLeg")
            ConnectParts(lines.RightLowerLeg_RightFoot, "RightLowerLeg", "RightFoot")

        else
            -- ถ้าผู้เล่นตายหรือหายไป ให้ซ่อนเส้น
            if ESP_Lines[player] then
                for _, line in pairs(ESP_Lines[player]) do
                    line.Visible = false
                end
            end
        end
    end
end

-- เชื่อมต่อกับ RenderStepped เพื่ออัปเดตทุกเฟรม
RunService.RenderStepped:Connect(UpdateESP)

-- เมื่อผู้เล่นออกจากเกม ให้ลบเส้นของคนนั้น
Players.PlayerRemoving:Connect(function(player)
    if ESP_Lines[player] then
        for _, line in pairs(ESP_Lines[player]) do
            line:Remove()
        end
        ESP_Lines[player] = nil
    end
end)

