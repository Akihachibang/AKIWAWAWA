local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

-- ตัวแปรเก็บสถานะและการวาด
local Box_Enabled = false
local Box_Cache = {} -- เก็บ Object ของ Box แยกตามผู้เล่น

-- ฟังก์ชันสร้าง Box ใหม่
local function CreateBox()
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(255, 0, 0) -- สีของกล่อง (แดง)
    box.Thickness = 1
    box.Transparency = 1
    box.Filled = false -- ไม่เติมสีข้างใน (ให้เป็นแค่กรอบ)
    return box
end

-- ฟังก์ชันลบ Box ทั้งหมด (เมื่อปิด ESP)
local function ClearBoxes()
    for _, box in pairs(Box_Cache) do
        box:Remove()
    end
    Box_Cache = {}
end

-- ฟังก์ชันอัปเดต Box
local function UpdateBoxes()
    -- ถ้าปิดระบบ ให้ลบกล่องทิ้งและหยุดทำงาน
    if not Box_Enabled then
        ClearBoxes()
        return
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            
            -- สร้าง Box ให้ผู้เล่นคนนี้ถ้ายังไม่มี
            if not Box_Cache[player] then
                Box_Cache[player] = CreateBox()
            end

            local box = Box_Cache[player]
            local rootPart = player.Character.HumanoidRootPart
            
            -- คำนวณตำแหน่งบนหน้าจอ (WorldToViewportPoint)
            local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

            if onScreen then
                -- คำนวณขนาดของ Box ตามระยะห่าง (ยิ่งไกลยิ่งเล็ก)
                -- 2000 และ 1000 คือค่า scaling factor ปรับได้ตามความเหมาะสม
                local rootPos = rootPart.Position
                local dist = (Camera.CFrame.Position - rootPos).Magnitude
                local scaleFactor = 1000 / dist
                
                local width = 2 * scaleFactor
                local height = 3.5 * scaleFactor -- ปกติความสูงจะมากกว่าความกว้าง

                -- กำหนดตำแหน่งและขนาดของ Box
                box.Size = Vector2.new(width, height)
                -- จัดตำแหน่งให้ Box อยู่กึ่งกลางตัวละคร (ลบครึ่งหนึ่งของขนาดออกจากจุดศูนย์กลาง)
                box.Position = Vector2.new(vector.X - width / 2, vector.Y - height / 2)
                
                box.Visible = true
            else
                box.Visible = false
            end
        else
            -- ถ้าผู้เล่นไม่อยู่ในเงื่อนไข (ตาย/หาย) ให้ซ่อน Box
            if Box_Cache[player] then
                Box_Cache[player].Visible = false
            end
        end
    end
end

-- ลบ Box ของคนที่ออกจากเกม
Players.PlayerRemoving:Connect(function(player)
    if Box_Cache[player] then
        Box_Cache[player]:Remove()
        Box_Cache[player] = nil
    end
end)

-- รันฟังก์ชัน Update ทุกเฟรม
RunService.RenderStepped:Connect(UpdateBoxes)

