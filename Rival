local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

-- ตัวแปรเก็บสถานะและ Cache ของเส้น
local Tracer_Enabled = false
local Tracer_Cache = {} -- เก็บเส้นแยกตามผู้เล่น

-- ฟังก์ชันสร้างเส้น Tracer ใหม่
local function CreateTracer()
    local line = Drawing.new("Line")
    line.Visible = false
    line.Color = Color3.fromRGB(0, 255, 0) -- สีเขียว
    line.Thickness = 1
    line.Transparency = 1
    return line
end

-- ฟังก์ชันลบเส้นทั้งหมด
local function ClearTracers()
    for _, line in pairs(Tracer_Cache) do
        line:Remove()
    end
    Tracer_Cache = {}
end

-- ฟังก์ชันอัปเดตเส้น Tracer
local function UpdateTracers()
    -- ถ้าปิดระบบ ให้ลบเส้นทิ้งแล้วหยุดทำงาน
    if not Tracer_Enabled then
        ClearTracers()
        return
    end

    -- จุดเริ่มต้นของเส้น (กึ่งกลางด้านล่างของจอ)
    -- ถ้าอยากให้เริ่มจากกลางจอเปลี่ยนเป็น: Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local Origin = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            
            -- สร้างเส้นให้ผู้เล่นคนนี้ถ้ายังไม่มี
            if not Tracer_Cache[player] then
                Tracer_Cache[player] = CreateTracer()
            end

            local line = Tracer_Cache[player]
            local rootPart = player.Character.HumanoidRootPart
            
            -- คำนวณตำแหน่งศัตรูบนหน้าจอ
            local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

            if onScreen then
                line.From = Origin -- จุดเริ่ม (ล่างจอ)
                line.To = Vector2.new(vector.X, vector.Y) -- จุดปลาย (ตัวศัตรู)
                line.Visible = true
            else
                -- ถ้าศัตรูไม่อยู่ในจอ ให้ซ่อนเส้น (จะได้ไม่รกหรือบัค)
                line.Visible = false
            end
        else
            -- ถ้าผู้เล่นตาย/หายไป ให้ซ่อนเส้น
            if Tracer_Cache[player] then
                Tracer_Cache[player].Visible = false
            end
        end
    end
end

-- ลบเส้นเมื่อผู้เล่นออกจากเกม
Players.PlayerRemoving:Connect(function(player)
    if Tracer_Cache[player] then
        Tracer_Cache[player]:Remove()
        Tracer_Cache[player] = nil
    end
end)

-- รันฟังก์ชัน Update ทุกเฟรม
RunService.RenderStepped:Connect(UpdateTracers)

